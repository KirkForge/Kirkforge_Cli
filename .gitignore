# Build artifacts
target/
__pycache__/
*.pyc
node_modules/
dist/
*.tsbuildinfo
# Workspace members share the root Cargo.lock; stray per-crate locks are stale.
crates/*/Cargo.lock

# Editor / OS cruft
*.swp
*.swo
*~
.DS_Store

# LLM/agent per-machine instructions (internal to the operator/session).
# NOTE: AGENTS.md, state.md are TRACKED (worker contract + repo state). Do not ignore them.
review.md
.claude/
CLAUDE.md

# Agent work files (per-session, not tracked — per AGENTS.md worker contract)
workplan.md
lessons.md

# Banned-tool output dirs — kept ignored to block recurrence (gitnexus/graphify
# are uninstalled & banned; these patterns ensure the dirs can't sneak back in).
graphify-out/
.gitnexus/
.gitnexus.bak/

# Local workflow scratch files created during smoke tests.
.kirkforge/workflows/

# Bench baseline reports (per-machine, not tracked)
benches/baselines/
build_rs_cov.profraw
# Covers .worktrees/ and its locks subdir (.worktrees/locks/) intentionally.
.worktrees/
.vix/

# Local context-index cache (ADR-037 Phase 4)
.kf-code/
