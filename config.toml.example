# KirkForge example configuration
#
# Copy this file to ~/.local/share/kf-code/config.toml and uncomment the
# settings you want to change. Any field omitted from the real config file
# keeps its built-in default, so a minimal config can be a single line.

# ---------------------------------------------------------------------------
# Model and endpoint
# ---------------------------------------------------------------------------

# Default model used when `kf-code run` is invoked without `--model`.
# Examples: "kimi-2.7k-coder:cloud", "glm-5.2:cloud", "qwen3:32b:cloud",
# or any model name your Ollama / OpenAI-compatible gateway knows.
# Default: "" (empty — you must pick a model with -m/--model).
# default_model = ""

# URL of the Ollama or OpenAI-compatible gateway. This is where requests are
# routed; it can be a local Ollama install or a cloud provider endpoint.
# For the OpenAI-compatible /v1/chat/completions adapter, both forms work:
#   ollama_host = "http://localhost:11434"
#   ollama_host = "http://localhost:11434/v1"
# The trailing /v1 is de-duplicated so neither produces /v1/v1/chat/completions.
# Default: "" (empty).
# ollama_host = ""

# Per-adapter streaming idle timeout in seconds. If no byte arrives from the
# model within this window, the stream is aborted with a StreamEvent::Error.
# 180s is well above any realistic inter-token silence but turns a wedged HTTP
# body into a clean error instead of hanging the agent loop. Default: 180.
# streaming_timeout_secs = 180

# ---------------------------------------------------------------------------
# Safety / approval
# ---------------------------------------------------------------------------

# When true, all tool calls and `!` passthrough are approved automatically.
# Useful for scripted non-interactive runs, dangerous for normal interactive
# coding. Default: false.
# auto_approve = false

# When true, destructive tools (write_file, edit_file, bash) report what they
# would do without actually doing it. Read-only tools still run normally.
# Useful for reviewing the model's intended edits before allowing them.
# Default: false.
# dry_run = false

# When true, the `!command` passthrough routes through the same approval gate
# as the bash tool. Default: false (passthrough is friction-free).
# bang_requires_approval = false

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# When true, scheduled bash jobs are allowed to run commands that would
# normally require interactive approval. Default: false. Only enable if you
# fully trust the scheduled commands.
# scheduled_bash_auto_approve = false

# Maximum number of scheduled jobs the daemon may run concurrently.
# Additional due jobs are queued until a slot frees up. Default: 4.
# max_concurrent_scheduled_jobs = 4

# Maximum number of background tasks (task(background=true)) that may run
# concurrently. Additional tasks are either queued or rejected depending on
# task_concurrency_mode. Clamped to 1–64. Default: 4.
# max_background_tasks = 4

# Backpressure mode when max_background_tasks is reached:
#   "queue"  — wait for a slot (default, current behavior)
#   "reject" — return a Failure immediately with a hint to use task_output
# task_concurrency_mode = "queue"

# Ceiling the `task` tool applies to the model-supplied max_turns argument
# (WO 48.34) — a runaway value cannot reach the subagent executor loop.
# Clamped to 1–1024. Default: 32.
# max_subagent_turns = 32

# ---------------------------------------------------------------------------
# Computer-use browser tool ([computer_use] table — SecurityConfig is flattened
# into the top level, so the table is [computer_use], not [security.computer_use])
# ---------------------------------------------------------------------------

# Headless Chrome configuration for the `computer_use` tool. The tool is
# available only to vision-capable models when `enabled = true`.
# [computer_use]
# enabled = false
# chrome_path = ""        # explicit Chrome/Chromium path; "" = auto-detect
# headful = false         # launch a visible window (debugging)
# width = 1280            # emulated viewport width
# height = 800            # emulated viewport height
# startup_timeout_secs = 30
# wait_timeout_secs = 10
# max_steps = 20          # cap on browser-session steps (infinite-loop guard)

# Activate the Anthropic HOSTED computer_use beta (coordinate-vision model)
# instead of the local headless-Chrome CDP tool. Requires building kf-code
# with the `computer_use` Cargo feature (`--features computer_use`); without
# it this flag is inert. When true, width/height are sent as the hosted
# display dims. Default: false. See WO 28.16.
# hosted = false

# ---------------------------------------------------------------------------
# Anthropic cloud routing
# ---------------------------------------------------------------------------

# Which Anthropic-compatible provider to use for Claude model names.
# Options: "anthropic" (default), "bedrock", "vertex".
# anthropic_provider = "anthropic"

# API key for direct Anthropic access. When set, the Anthropic adapter
# sends `x-api-key` with every request. Falls back to the
# `ANTHROPIC_API_KEY` environment variable when omitted from config.
# anthropic_api_key = ""

# Base URL for the first-party Anthropic Messages API (/v1/messages is
# appended). Defaults to the real Anthropic endpoint so the x-api-key
# header reaches Anthropic, not the shared ollama_host. Set this only if
# you route Anthropic traffic through a proxy or gateway.
# anthropic_api_base = "https://api.anthropic.com"

# Per-provider API keys for other adapters. Each falls back to the
# corresponding `*_API_KEY` environment variable when omitted.
# openai_api_key = ""
# deepseek_api_key = ""
# gemini_api_key = ""
# kimi_api_key = ""

# AWS region for Bedrock inference. Default: "us-east-1".
# aws_region = "us-east-1"

# GCP project id for Vertex AI. Required when anthropic_provider = "vertex".
# gcp_project_id = ""

# GCP region for Vertex AI. Default: "us-central1".
# gcp_region = "us-central1"

# Path to a GCP service-account JSON key for Vertex AI. Falls back to
# GOOGLE_APPLICATION_CREDENTIALS. Default: "".
# gcp_service_account_path = ""

# ---------------------------------------------------------------------------
# Subagent provider override (brain+brawn, WO 30.0.6)
# ---------------------------------------------------------------------------
# Optional separate model + host + API keys for subagents spawned by the
# `task` tool. Every field is optional; an unset field inherits the parent's
# value above. The `task` tool's per-call `model` arg still wins over both.
#
# Enables brain+brawn: an expensive cloud model orchestrates while cheap
# brawn runs on a different provider/account.
#
# [subagent_provider]
# model = "qwen2.5:0.5b"
# ollama_host = "http://localhost:11434"
# anthropic_api_key = ""
# openai_api_key = ""
# deepseek_api_key = ""
# gemini_api_key = ""
# kimi_api_key = ""

# ---------------------------------------------------------------------------
# Sandbox and filesystem access
# ---------------------------------------------------------------------------

# Working directory the bash tool defaults to and is confined inside. When
# omitted, the launch-time current working directory is used (sandboxed).
# An explicit path overrides cwd capture. An empty string ("") is the
# explicit opt-out that disables the sandbox. Default: omitted (cwd).
# sandbox_dir = "."

# When true, the bash tool forces its subprocess cwd inside `sandbox_dir` and
# rejects explicit `workdir` args that escape it. Default: true.
# bash_sandbox_workdir = true

# When true, bash commands must match `bash_allowlist` or be denied (WO 32.18).
# Match policy: prefix-match on the command head (first token). Compound
# commands (`&&`, `;`, `|`) require every clause to match or the whole
# command is denied. Default: false (no regression for existing configs).
# Env: KF_CODE_BASH_REQUIRE_ALLOWLIST (bool), KF_CODE_BASH_ALLOWLIST (colon-separated).
# bash_require_allowlist = false
# bash_allowlist = ["ls", "echo", "grep", "cat", "cargo", "git"]

# Lightweight rlimit hardening for the non-Docker bash path (ADR-054).
# When `harden` is true and Docker is NOT enabled, the bash tool applies
# RLIMIT_CPU / RLIMIT_AS / RLIMIT_FSIZE to the child shell in a pre_exec
# hook (Unix only; Windows no-op with a one-shot warning). Ignored when
# [docker] enabled is true. Seccomp (WO 30.4) is a separate opt-in Cargo
# feature (`--features seccomp`), not a config field — it adds a syscall
# allowlist filter in the same pre_exec hook, after landlock + rlimits.
# [sandbox]
# harden = false
# cpu_limit_secs = 300       # SIGXCPU after this many CPU seconds
# memory_limit_mb = 2048     # ENOMEM past this address space
# filesize_limit_mb = 512   # SIGXFSZ on a write past this file size

# When true, write_file/edit_file reject paths that resolve inside dotfile
# directories (e.g. ~/.ssh). Default: true.
# block_dotfiles = true

# When true, write_file/edit_file also reject paths inside git-ignored dotfile
# directories such as .env files. Default: true.
# block_gitignored_dotfiles = true

# When true, read_file rejects binary files instead of returning truncated
# base64. Default: false.
# block_binary_reads = false

# When true, read_file wraps minified source in a `<minified lang="...">`
# envelope and write_file/edit_file expand that envelope back to readable
# source before writing. Default: true (read_file auto-minify round-trips
# through edit_file without breaking string-match).
# minify_write_side = true

# read_file auto-minifies (strips comments, collapses blank lines) when
# the file content exceeds this many bytes and the caller did not pass an
# explicit `minify` argument. Small files are never auto-minified. The
# model can pass minify=false to opt out per-call. Default: 4096.
# Env: KF_CODE_MINIFY_ABOVE_BYTES.
# minify_above_bytes = 4096

# Maximum bytes the read_file tool returns. Default: 1048576 (1 MiB).
# max_file_read_size = 1048576

# Maximum size (in bytes) of an existing file that write_file/edit_file may
# overwrite. Set to 0 to disable the limit. Default: 1048576 (1 MiB).
# max_overwrite_size = 1048576

# When true, read_file follows symlinks. Default: false.
# follow_symlinks = false

# ---------------------------------------------------------------------------
# Permission rules (allow / ask / deny)
# ---------------------------------------------------------------------------
#
# Per-tool, per-argument allow/ask/deny rules. Each rule matches a tool call
# against a glob pattern and decides whether the call is auto-approved (allow),
# prompts the user (ask), or is refused outright (deny). Rules are evaluated
# in declaration order — first match wins. When no rule matches, the default
# is Ask (unless auto_approve = true, in which case Allow).
#
# See src/shared/permission.rs for the full engine description.
#
# [[permission_rules]]
# tool = "bash"
# key = "command"
# pattern = "cargo test*"
# action = "allow"
#
# [[permission_rules]]
# tool = "edit_file"
# key = "path"
# pattern = "src/**/*.rs"
# action = "allow"
#
# [[permission_rules]]
# tool = "bash"
# key = "command"
# pattern = "rm -rf **"
# action = "deny"
#
# Field reference:
#   tool    — exact tool name ("bash", "edit_file", "write_file", ...) or "*"
#   key     — which argument to match: "command" for bash, "path" for file
#             tools, or "*" to match without inspecting args
#   pattern — glob. "*" = one path segment (does NOT cross "/"). "**" = any
#             chars including "/". For bash deny rules, lone "*" is promoted
#             to "**" so deny patterns block across slashes.
#   action  — "allow", "ask", or "deny"

# ---------------------------------------------------------------------------
# Deny / allow lists
# ---------------------------------------------------------------------------

# Glob patterns for paths the file tools are not allowed to touch.
# deny_paths = ["**/.ssh/**", "**/secret/**"]

# Glob patterns for URLs the bash tool is not allowed to curl/wget/etc.
# deny_urls = ["https://example.com/internal/*"]

# File extensions that file tools will refuse to write.
# deny_extensions = [".key", "*.pem"]

# If non-empty, write_file/edit_file outside these directories are rejected.
# allowed_write_dirs = ["/home/me/projects"]

# Extra filesystem paths added to the landlock allow-list (Linux only, WO 27.1).
# The bash tool gets full read/write access to these in addition to the workdir
# and home/XDG dirs. Use this to grant access to a sibling monorepo or a
# non-default cargo/rustup cache that lives outside the workspace. Default: [].
# Env: KF_CODE_LANDLOCK_EXTRA_PATHS (colon-separated, like PATH).
# landlock_extra_paths = ["/home/me/other-monorepo", "/opt/cargo-cache"]

# ---------------------------------------------------------------------------
# Conversation context
# ---------------------------------------------------------------------------

# When true, old turns are carried over into new sessions. Default: true.
# carryover_enabled = true

# Maximum characters of a single tool result that are kept in context.
# Default: 4000.
# max_tool_result_chars = 4000

# Number of recent messages kept verbatim during context compaction. Must be
# at least 1. Default: 2 (one user turn + one assistant turn).
# preserve_recent_messages = 2

# Maximum model↔tool iterations within a single turn. Prevents runaway loops
# during large codebase analysis. Default: 200.
# max_tool_calls_per_turn = 200

# Maximum consecutive FinishReason::Length continuations per turn. When the
# model hits max_tokens, the executor injects a continuation message and loops.
# This cap limits how many times that can happen. 0 disables continuation
# entirely (treats Length as Stop). Default: 20, max: 50.
# max_continuation_rounds = 20

# ---------------------------------------------------------------------------
# Summarization (optional LLM-based compaction)
# ---------------------------------------------------------------------------

# When true, `/compact` uses the model below to summarize old turns instead
# of naive truncation. Falls back to truncation if summarization fails.
# summarize_enabled = false

# Fast/cheap model used for summarization. Empty means summarization is
# disabled by default.
# summarize_model = ""

# ---------------------------------------------------------------------------
# Adapter routing overrides
# ---------------------------------------------------------------------------

# Override the built-in model→adapter routing table. Each entry maps a
# model-name prefix to an AdapterKind. Longest-prefix match wins. When
# this section is absent (the default), hardcoded prefix rules are used.
#
# Example: route "grok-" models through the OpenAI-compatible adapter and
# remap "deepseek" from Ollama to OpenAI-compat:
#
# [adapter_routing]
# "grok-" = "OpenAiCompat"
# "deepseek" = "OpenAiCompat"

# Env override: KF_CODE_ADAPTER_ROUTING
# Comma-separated prefix=Kind pairs, e.g.:
#   KF_CODE_ADAPTER_ROUTING="grok-=OpenAiCompat,my-llm=Ollama"
# This replaces the TOML [adapter_routing] section entirely when set.

# ---------------------------------------------------------------------------
# Smart routing (experimental)
# ---------------------------------------------------------------------------

# When true, the first user message each turn is classified by complexity and
# the router may suggest a model tier. Advisory only today.
# routing_enabled = false

# Model used for complexity classification. Empty means keyword heuristics.
# router_model = ""

# Per-tier model overrides. Valid keys: "simple", "medium", "complex".
# [routing_model_map]
# simple = "qwen3:32b:cloud"
# medium = "glm-5.2:cloud"
# complex = "kimi-2.7k-coder:cloud"

# ---------------------------------------------------------------------------
# MCP servers (optional external tools)
# ---------------------------------------------------------------------------
#
# Each server is spawned as a subprocess. Its tools become available inside
# KirkForge prefixed with `mcp/<name>/`.

# [[mcp_servers]]
# name = "fetch"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-fetch"]
# [mcp_servers.env_vars]
# LOG_LEVEL = "warn"
#
# Sampling (ADR-072): when an MCP server calls `sampling/createMessage`, the
# request is routed through the same approval prompt as tool calls. In headless
# / non-interactive mode it is DENIED by default. Set this to true to
# auto-approve sampling from trusted servers (explicit trust decision).
# allow_sampling_unattended = false

# ---------------------------------------------------------------------------
# LSP servers (optional — gives the model symbol-aware code navigation)
# ---------------------------------------------------------------------------
#
# Each entry launches a language server subprocess. The `lsp_query` tool
# exposes go_to_definition / find_references / hover / document_symbols /
# find_implementations / workspace_symbols / diagnostics for that language.

# [[lsp_servers]]
# language = "rust"
# extensions = [".rs"]
# command = "rust-analyzer"
# [[lsp_servers]]
# language = "typescript"
# extensions = [".ts", ".tsx", ".js", ".jsx"]
# command = "typescript-language-server"
# args = ["--stdio"]

# ---------------------------------------------------------------------------
# Output / model behavior
# ---------------------------------------------------------------------------

# When true, request JSON-formatted responses. Models vary in how well they
# honor this; tool calls may still appear inline. Default: false.
# json_mode = false

# ---------------------------------------------------------------------------
# Git commit helper
# ---------------------------------------------------------------------------

# Maximum file size (in bytes) allowed in a `/commit`. Files larger than this
# are a hard blocker. Default: 5242880 (5 MiB).
# commit_max_file_size = 5242880

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Per-tool hard timeout in seconds. Individual tools may apply shorter
# internal timeouts. Clamped to [1, 3600]. Default: 120.
# tool_timeout_secs = 120

# Optional path for the append-only JSONL audit log. Set to an empty string
# to disable auditing. Default: <data_dir>/audit.ndjson.
# audit_log_path = ""

# Optional directory containing lifecycle hook scripts (`<event>.sh`). When
# omitted, the default `~/.local/share/kf-code/hooks/` is used.
# hooks_dir = ""

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------

# Show the memory widget (fact count + last-updated turn) in the TUI status
# bar. Default: true.
# memory_show_in_status = true

# TUI color theme. Built-ins: "default" (the prior hard-coded colors),
# "dark" (high-contrast dark), "light" (readable on white terminals),
# "monokai" (warm palette). Unknown values fall back to "default".
# Live-switchable via the /theme slash command. Default: "default".
# Env: KF_CODE_THEME.
# theme = "default"

# Enable TUI mouse capture (click/drag/scroll). Set false if mouse
# capture hijacks your terminal's native scrollback / scroll wheel.
# Default: true. Env: KF_CODE_MOUSE_ENABLED.
# mouse_enabled = true

# ---------------------------------------------------------------------------
# Opt-in extra commands (WO 47.13)
# ---------------------------------------------------------------------------
#
# Low-traffic TUI commands are disabled unless their key is listed here
# (default empty = all off; live via /reload). DisplayConfig is flattened
# into the top level, so this is a TOP-LEVEL key — the `[display]
# extra_commands = [...]` form the TUI's enable-hint message prints does
# NOT parse (known issue, needs a WO); write it top-level as below.
# Recognized keys:
#   "gh"            — /gh
#   "route"         — /route
#   "metrics"       — /metrics
#   "carryover"     — /carryover (display command only)
#   "personas"      — /plan, /explore, /coder
#   "jobs-schedule" — the /jobs cron surface (schedule, scheduled,
#                     run-now, logs); background-bash /jobs stays always-on
#   "mentions"      — @-mention expansion + completion
# extra_commands = ["gh", "jobs-schedule"]

# ---------------------------------------------------------------------------
# Subagent artifact policy (WO 35.2 / WO 45.37)
# ---------------------------------------------------------------------------
#
# How coder-subagent changes reach the parent workspace. SessionConfig is
# flattened into the top level, so artifact_policy is a TOP-LEVEL key —
# a `[session]` table form is silently ignored. When the policy selects
# worktree isolation, the coder subagent gets its own `git worktree`
# (branched from the parent sandbox when that is itself a worktree, else
# the process CWD). The cloned config's `sandbox_dir` is pointed at the
# worktree before `access_from_config`, so the path guard, landlock extra
# paths, and the subagent executor's guard tower all center on the
# worktree. Before the worktree is dropped, uncommitted edits are
# captured with `git diff HEAD` and returned as an appliable patch
# appended to the task summary.
#
# artifact_policy = "direct_write"
# WO 45.37: typed artifact policy replacing the worktree_enabled +
# auto_apply_patch bool pair. Three variants:
#   "direct_write" — no worktree; coder writes directly to parent (default).
#   "patch_only"    — worktree isolation; patch surfaced as text in the
#                    TUI summary for manual `git apply` / `/apply`.
#   "auto_apply"   — worktree isolation; patch `git apply`'d to the parent
#                    working tree automatically after the Reviewer phase.
#                    On conflict/dirty-tree the error is surfaced (not silent
#                    loss). The user still must `git commit` manually —
#                    there is no auto-commit variant.
# Legacy configs using top-level `worktree_enabled` + `auto_apply_patch`
# are still accepted: `true`/`false` → `patch_only`, `true`/`true` →
# `auto_apply`, `false`/`_` → `direct_write`.

# ---------------------------------------------------------------------------
# Workspace plugin sources
# ---------------------------------------------------------------------------
#
# The built-in plugins (`kf-plugin`, `stratum`, `kf-budget`) are compiled-in
# behind cargo features and need no filesystem source. The names listed in
# `enabled_plugins` below gate the compiled-in registration: dropping a name
# from the list disables that plugin's tools/hooks on the next `kf-code run`.
# Disable at runtime with `/plugins toggle <name>` or remove it from
# `enabled_plugins`.
#
# Custom v1 (`PluginToolWrapper`) plugins can still be added by pointing a
# `plugin_sources` entry at a directory containing a `kf-code.toml` manifest.
# Relative paths resolve against the current working directory; in an
# installed release plugins are also looked up under
# `~/.local/share/kf-code/plugins/<name>`.
#
# SECURITY (H9 / WO 27.4): workspace plugin dirs are NOT trust roots by
# default. A model with `write_file` access can drop a plugin + manifest into
# a workspace path and trigger `/reload`, so signature verification on
# workspace plugins is enforced unless you explicitly opt in here. With the
# default (false), unsigned workspace plugins are rejected at load. Set this
# to true ONLY if no model/tool can write to any configured `plugin_sources`
# path — otherwise a planted plugin loads with full user privileges.
#
# The same flag gates `.claude/agents/*.md` dynamic agent files (WO 39.3):
# a dropped agent file widens a subagent's toolset, so the workspace
# `.claude/agents/` dir is refused unless this is true (agents under the
# canonical data dir are always trusted). See docs/TECHNICAL.md "Claude
# compatibility layer" for the agent file format (frontmatter name /
# description / tools / model + body = system prompt).
# plugin_trust_workspace = false
#
# Content-hash consent ledger (WO 45.61 / WO 46.13, default ON): a signed
# plugin must ALSO be ledger-approved with a matching `bundle_hash`
# (covering manifest + command scripts) before it loads. The manifest-only
# signature does not cover the scripts the manifest points to; the ledger
# does. Approve pending bundles with `/plugins approve <n>`. Set to false
# to opt out of the ledger layer.
# plugin_consent_ledger = true
#
# [plugin_sources]
# my-custom-plugin = "path/to/plugin-dir"
#
# enabled_plugins gates which compiled-in plugins register their tools/hooks
# on the next `kf-code run`. The default (unset) enables all three built-ins
# (kf-plugin, stratum, kf-budget). Listing only a subset silently disables
# the unlisted ones — e.g. `enabled_plugins = ["kf-plugin"]` disables
# stratum and budget tools/hooks even though their cargo features are on.
# Disable at runtime with `/plugins toggle <name>`.
# enabled_plugins = ["kf-plugin", "stratum", "kf-budget"]

# ---------------------------------------------------------------------------
# Stratum compression and token budget
# ---------------------------------------------------------------------------
#
# Stratum mode selection (off / lite / full / ultra). When omitted the
# `STRATUM_MODE` env var is consulted; when that is also unset Stratum
# defaults to "full". Config takes precedence over the env var.
# stratum_mode = "full"  # off, lite, full, ultra (default: full)

# Token budget ceiling for the Plugin3 budget guard. Tool output is sliced
# once usage crosses the approaching ratio. Default: 200000.
# budget_ceiling = 200000  # token budget ceiling (default: 200000)

# Fraction of the ceiling at which the "approaching" state triggers and
# slicing begins. Default: 0.8.
# budget_approaching_ratio = 0.8  # ratio at which "approaching" state triggers (default: 0.8)

# Maximum cumulative doom-loop detections before the circuit breaker fires.
# When hit, the executor auto-switches to plan mode (or halts if already
# in plan mode). Set to 0 to disable the circuit breaker. Default: 1
# (fires on the first doom-loop detection, which requires 3 identical
# consecutive tool errors).
# doom_loop_max_hits = 1
