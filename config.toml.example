# KirkForge example configuration
#
# Copy this file to ~/.local/share/kf-code/config.toml and uncomment the
# settings you want to change. Any field omitted from the real config file
# keeps its built-in default, so a minimal config can be a single line.

# ---------------------------------------------------------------------------
# Model and endpoint
# ---------------------------------------------------------------------------

# Default model used when `kf-code run` is invoked without `--model`.
# Examples: "kimi-2.7k-coder:cloud", "glm-5.2:cloud", "qwen3:32b:cloud",
# or any model name your Ollama / OpenAI-compatible gateway knows.
# Default: "" (empty — you must pick a model with -m/--model).
# default_model = ""

# URL of the Ollama or OpenAI-compatible gateway. This is where requests are
# routed; it can be a local Ollama install or a cloud provider endpoint.
# Default: "" (empty).
# ollama_host = ""

# ---------------------------------------------------------------------------
# Safety / approval
# ---------------------------------------------------------------------------

# When true, all tool calls and `!` passthrough are approved automatically.
# Useful for scripted non-interactive runs, dangerous for normal interactive
# coding. Default: false.
# auto_approve = false

# When true, destructive tools (write_file, edit_file, bash) report what they
# would do without actually doing it. Read-only tools still run normally.
# Useful for reviewing the model's intended edits before allowing them.
# Default: false.
# dry_run = false

# When true, the `!command` passthrough routes through the same approval gate
# as the bash tool. Default: false (passthrough is friction-free).
# bang_requires_approval = false

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# When true, scheduled bash jobs are allowed to run commands that would
# normally require interactive approval. Default: false. Only enable if you
# fully trust the scheduled commands.
# scheduled_bash_auto_approve = false

# Maximum number of scheduled jobs the daemon may run concurrently.
# Additional due jobs are queued until a slot frees up. Default: 4.
# max_concurrent_scheduled_jobs = 4

# Maximum number of background tasks (task(background=true)) that may run
# concurrently. Additional tasks are either queued or rejected depending on
# task_concurrency_mode. Clamped to 1–64. Default: 4.
# max_background_tasks = 4

# Backpressure mode when max_background_tasks is reached:
#   "queue"  — wait for a slot (default, current behavior)
#   "reject" — return a Failure immediately with a hint to use task_output
# task_concurrency_mode = "queue"

# ---------------------------------------------------------------------------
# Computer-use browser tool
# ---------------------------------------------------------------------------

# When true, the `computer_use` tool is available to vision-capable models.
# It launches a headless Chrome tab and lets the model navigate, click,
# type, and take screenshots. Default: false.
# computer_use_enabled = false

# Path to a Chrome/Chromium binary. If empty the CLI tries a small set of
# common binary names. Default: "".
# chrome_path = ""

# Extra command-line flags passed to Chrome on launch. Default: [] (none).
# chrome_extra_flags = []

# Width of the emulated browser viewport in pixels. Default: 1280.
# chrome_viewport_width = 1280

# Height of the emulated browser viewport in pixels. Default: 800.
# chrome_viewport_height = 800

# ---------------------------------------------------------------------------
# Anthropic cloud routing
# ---------------------------------------------------------------------------

# Which Anthropic-compatible provider to use for Claude model names.
# Options: "anthropic" (default), "bedrock", "vertex".
# anthropic_provider = "anthropic"

# API key for direct Anthropic access. When set, the Anthropic adapter
# sends `x-api-key` with every request. Falls back to the
# `ANTHROPIC_API_KEY` environment variable when omitted from config.
# anthropic_api_key = ""

# Per-provider API keys for other adapters. Each falls back to the
# corresponding `*_API_KEY` environment variable when omitted.
# openai_api_key = ""
# deepseek_api_key = ""
# gemini_api_key = ""
# kimi_api_key = ""

# AWS region for Bedrock inference. Default: "us-east-1".
# aws_region = "us-east-1"

# GCP project id for Vertex AI. Required when anthropic_provider = "vertex".
# gcp_project_id = ""

# GCP region for Vertex AI. Default: "us-central1".
# gcp_region = "us-central1"

# Path to a GCP service-account JSON key for Vertex AI. Falls back to
# GOOGLE_APPLICATION_CREDENTIALS. Default: "".
# gcp_service_account_path = ""

# ---------------------------------------------------------------------------
# Sandbox and filesystem access
# ---------------------------------------------------------------------------

# Working directory the bash tool defaults to and is confined inside. When
# omitted, the launch-time current working directory is used (sandboxed).
# An explicit path overrides cwd capture. An empty string ("") is the
# explicit opt-out that disables the sandbox. Default: omitted (cwd).
# sandbox_dir = "."

# When true, the bash tool forces its subprocess cwd inside `sandbox_dir` and
# rejects explicit `workdir` args that escape it. Default: true.
# bash_sandbox_workdir = true

# Lightweight rlimit hardening for the non-Docker bash path (ADR-054).
# When `harden` is true and Docker is NOT enabled, the bash tool applies
# RLIMIT_CPU / RLIMIT_AS / RLIMIT_FSIZE to the child shell in a pre_exec
# hook (Unix only; Windows no-op with a one-shot warning). Ignored when
# [security.docker] enabled is true. seccomp is future work.
# [security.sandbox]
# harden = false
# cpu_limit_secs = 300       # SIGXCPU after this many CPU seconds
# memory_limit_mb = 2048     # ENOMEM past this address space
# filesize_limit_mb = 512   # SIGXFSZ on a write past this file size

# When true, write_file/edit_file reject paths that resolve inside dotfile
# directories (e.g. ~/.ssh). Default: false.
# block_dotfiles = false

# When true, write_file/edit_file also reject paths inside git-ignored dotfile
# directories such as .env files. Default: true.
# block_gitignored_dotfiles = true

# When true, read_file rejects binary files instead of returning truncated
# base64. Default: false.
# block_binary_reads = false

# When true, read_file wraps minified source in a `<minified lang="...">`
# envelope and write_file/edit_file expand that envelope back to readable
# source before writing. Default: false (will flip to true after shake-out).
# minify_write_side = false

# read_file auto-minifies (strips comments, collapses blank lines) when
# the file content exceeds this many bytes and the caller did not pass an
# explicit `minify` argument. Small files are never auto-minified. The
# model can pass minify=false to opt out per-call. Default: 4096.
# Env: KF_CODE_MINIFY_ABOVE_BYTES.
# minify_above_bytes = 4096

# Maximum bytes the read_file tool returns. Default: 1048576 (1 MiB).
# max_file_read_size = 1048576

# Maximum size (in bytes) of an existing file that write_file/edit_file may
# overwrite. Set to 0 to disable the limit. Default: 1048576 (1 MiB).
# max_overwrite_size = 1048576

# When true, read_file follows symlinks. Default: false.
# follow_symlinks = false

# ---------------------------------------------------------------------------
# Deny / allow lists
# ---------------------------------------------------------------------------

# Glob patterns for paths the file tools are not allowed to touch.
# deny_paths = ["**/.ssh/**", "**/secret/**"]

# Glob patterns for URLs the bash tool is not allowed to curl/wget/etc.
# deny_urls = ["https://example.com/internal/*"]

# File extensions that file tools will refuse to write.
# deny_extensions = [".key", "*.pem"]

# If non-empty, write_file/edit_file outside these directories are rejected.
# allowed_write_dirs = ["/home/me/projects"]

# ---------------------------------------------------------------------------
# Conversation context
# ---------------------------------------------------------------------------

# When true, old turns are carried over into new sessions. Default: true.
# carryover_enabled = true

# Maximum characters of a single tool result that are kept in context.
# Default: 4000.
# max_tool_result_chars = 4000

# Number of recent messages kept verbatim during context compaction. Must be
# at least 1. Default: 2 (one user turn + one assistant turn).
# preserve_recent_messages = 2

# Maximum model↔tool iterations within a single turn. Prevents runaway loops
# during large codebase analysis. Default: 50.
# max_tool_calls_per_turn = 50

# Maximum consecutive FinishReason::Length continuations per turn. When the
# model hits max_tokens, the executor injects a continuation message and loops.
# This cap limits how many times that can happen. 0 disables continuation
# entirely (treats Length as Stop). Default: 5, max: 50.
# max_continuation_rounds = 5

# ---------------------------------------------------------------------------
# Summarization (optional LLM-based compaction)
# ---------------------------------------------------------------------------

# When true, `/compact` uses the model below to summarize old turns instead
# of naive truncation. Falls back to truncation if summarization fails.
# summarize_enabled = false

# Fast/cheap model used for summarization. Empty means summarization is
# disabled by default.
# summarize_model = ""

# ---------------------------------------------------------------------------
# Adapter routing overrides
# ---------------------------------------------------------------------------

# Override the built-in model→adapter routing table. Each entry maps a
# model-name prefix to an AdapterKind. Longest-prefix match wins. When
# this section is absent (the default), hardcoded prefix rules are used.
#
# Example: route "grok-" models through the OpenAI-compatible adapter and
# remap "deepseek" from Ollama to OpenAI-compat:
#
# [adapter_routing]
# "grok-" = "OpenAiCompat"
# "deepseek" = "OpenAiCompat"

# Env override: KF_CODE_ADAPTER_ROUTING
# Comma-separated prefix=Kind pairs, e.g.:
#   KF_CODE_ADAPTER_ROUTING="grok-=OpenAiCompat,my-llm=Ollama"
# This replaces the TOML [adapter_routing] section entirely when set.

# ---------------------------------------------------------------------------
# Smart routing (experimental)
# ---------------------------------------------------------------------------

# When true, the first user message each turn is classified by complexity and
# the router may suggest a model tier. Advisory only today.
# routing_enabled = false

# Model used for complexity classification. Empty means keyword heuristics.
# router_model = ""

# Per-tier model overrides. Valid keys: "simple", "medium", "complex".
# [routing_model_map]
# simple = "qwen3:32b:cloud"
# medium = "glm-5.2:cloud"
# complex = "kimi-2.7k-coder:cloud"

# ---------------------------------------------------------------------------
# MCP servers (optional external tools)
# ---------------------------------------------------------------------------
#
# Each server is spawned as a subprocess. Its tools become available inside
# KirkForge prefixed with `mcp/<name>/`.

# [[mcp_servers]]
# name = "fetch"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-fetch"]
# [mcp_servers.env_vars]
# LOG_LEVEL = "warn"
#
# Sampling (ADR-072): when an MCP server calls `sampling/createMessage`, the
# request is routed through the same approval prompt as tool calls. In headless
# / non-interactive mode it is DENIED by default. Set this to true to
# auto-approve sampling from trusted servers (explicit trust decision).
# allow_sampling_unattended = false

# ---------------------------------------------------------------------------
# LSP servers (optional — gives the model symbol-aware code navigation)
# ---------------------------------------------------------------------------
#
# Each entry launches a language server subprocess. The `lsp_query` tool
# exposes go_to_definition / find_references / hover / document_symbols /
# find_implementations / workspace_symbols / diagnostics for that language.

# [[lsp_servers]]
# language = "rust"
# extensions = [".rs"]
# command = "rust-analyzer"
# [[lsp_servers]]
# language = "typescript"
# extensions = [".ts", ".tsx", ".js", ".jsx"]
# command = "typescript-language-server"
# args = ["--stdio"]

# ---------------------------------------------------------------------------
# Output / model behavior
# ---------------------------------------------------------------------------

# When true, request JSON-formatted responses. Models vary in how well they
# honor this; tool calls may still appear inline. Default: false.
# json_mode = false

# ---------------------------------------------------------------------------
# Git commit helper
# ---------------------------------------------------------------------------

# Maximum file size (in bytes) allowed in a `/commit`. Files larger than this
# are a hard blocker. Default: 5242880 (5 MiB).
# commit_max_file_size = 5242880

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Per-tool hard timeout in seconds. Individual tools may apply shorter
# internal timeouts. Clamped to [1, 3600]. Default: 30.
# tool_timeout_secs = 30

# Optional path for the append-only JSONL audit log. Set to an empty string
# to disable auditing. Default: <data_dir>/audit.ndjson.
# audit_log_path = ""

# Optional directory containing lifecycle hook scripts (`<event>.sh`). When
# omitted, the default `~/.local/share/kf-code/hooks/` is used.
# hooks_dir = ""

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------

# Show the memory widget (fact count + last-updated turn) in the TUI status
# bar. Default: true.
# memory_show_in_status = true

# ---------------------------------------------------------------------------
# Workspace plugin sources
# ---------------------------------------------------------------------------
#
# The CLI ships with a built-in plugin source under the `plugins/` directory.
# It is enabled by default when the directory exists.
# Disable it at runtime with `/plugins toggle <name>` or remove it from
# `enabled_plugins`. Relative paths resolve against the current working
# directory; in an installed release the bundled plugin is looked up under
# `~/.local/share/kf-code/plugins/<name>`.
#
# [plugin_sources]
# kf-plugin = "plugins/kf-plugin"
#
enabled_plugins = ["kf-plugin"]

# ---------------------------------------------------------------------------
# Stratum compression and token budget
# ---------------------------------------------------------------------------
#
# Stratum mode selection (off / lite / full / ultra). When omitted the
# `STRATUM_MODE` env var is consulted; when that is also unset Stratum
# defaults to "full". Config takes precedence over the env var.
# stratum_mode = "full"  # off, lite, full, ultra (default: full)

# Token budget ceiling for the Plugin3 budget guard. Tool output is sliced
# once usage crosses the approaching ratio. Default: 200000.
# budget_ceiling = 200000  # token budget ceiling (default: 200000)

# Fraction of the ceiling at which the "approaching" state triggers and
# slicing begins. Default: 0.8.
# budget_approaching_ratio = 0.8  # ratio at which "approaching" state triggers (default: 0.8)

# Maximum cumulative doom-loop detections before the circuit breaker fires.
# When hit, the executor auto-switches to plan mode (or halts if already
# in plan mode). Set to 0 to disable the circuit breaker. Default: 1
# (fires on the first doom-loop detection, which requires 3 identical
# consecutive tool errors).
# doom_loop_max_hits = 1
